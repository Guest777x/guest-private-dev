        if not char then return end
        local lp = svc.Players.LocalPlayer
        local isOther = (lp ~= nil) and (svc.Players:GetPlayerFromCharacter(char) ~= lp)
        task.spawn(function()
            for _, d in ipairs(char:GetDescendants()) do stripObject(d, isOther) end
        end)
