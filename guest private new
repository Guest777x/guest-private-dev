local function resolveKey(name, fallback)
    if type(name) ~= "string" or name == "" then return fallback end
    local clean = name:gsub("^%s+", ""):gsub("%s+$", "")
    if clean == "" or clean == "NONE" then return nil end
    local ok, kc = pcall(function() return Enum.KeyCode[clean] end)
    if ok and kc then return kc end
    return fallback
end

