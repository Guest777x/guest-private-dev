        local baseH = startSize.Y / startScale
        local w = util.clamp(baseW + delta.X / startScale, baseW * minFrac, baseW * 2.2)
        local h2 = util.clamp(baseH + delta.Y / startScale, baseH * minFrac, baseH * 2.2)
        panelFrame.Size = UDim2.fromOffset(math.floor(w), math.floor(h2))
    end)

    conns[#conns + 1] = UIS.InputEnded:Connect(function(input)
        if input == dragInput then
            dragInput = nil
            if saveKey and panelFrame and panelFrame.Parent then
                pcall(function()
                    GS.config.cfg.positions = GS.config.cfg.positions or {}
                    GS.config.cfg.positions[saveKey .. "_size"] = {
                        w = panelFrame.Size.X.Offset,
                        h = panelFrame.Size.Y.Offset,
                    }
                    GS.config.save()
                end)
            end
        end
    end)

    GS.onDestroy(function()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    end)
    return grip
end

