local function findClosestSentry()
    local _, hrp = getChar()
    if not hrp then return nil end
    local best, bestD = nil, math.huge
    for _, c in ipairs(Workspace:GetChildren()) do
        local m = c.Name:match("^Sentry_(%d+)$")
        if m and c:IsA("Model") and tonumber(m) ~= LP.UserId then
            local root = c:FindFirstChildWhichIsA("BasePart", true)
            if root then
                local d = (hrp.Position - root.Position).Magnitude
                if d < bestD then bestD, best = d, c end
            end
        end
    end
    return best, bestD
end

