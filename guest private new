function steal.promptDistance(prompt)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end
    local parent = prompt and prompt.Parent
    local pos
    if parent then
        if parent:IsA("Attachment") then pos = parent.WorldPosition
        elseif parent:IsA("BasePart") then pos = parent.Position
        else
            local bp = parent:FindFirstAncestorWhichIsA("BasePart")
            if bp then pos = bp.Position end
        end
    end
    if not pos then return nil, nil end
    local h = hrp.Position
    return math.sqrt((pos.X - h.X) ^ 2 + (pos.Z - h.Z) ^ 2), (pos - h).Magnitude
end

