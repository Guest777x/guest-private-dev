            if a.mod ~= b.mod then return a.mod > b.mod end
            return a.name < b.name
        end)
        local inRoster, seen, merged = {}, {}, {}
        for _, m in ipairs(MUT_ROSTER) do inRoster[m.name] = true end
        for _, v in ipairs(MUT_LIST) do
            if inRoster[v] and not seen[v] then seen[v] = true; merged[#merged + 1] = v end
        end
        for _, m in ipairs(MUT_ROSTER) do
            if not seen[m.name] then seen[m.name] = true; merged[#merged + 1] = m.name end
        end
        for i = #MUT_LIST, 1, -1 do MUT_LIST[i] = nil end
        for i, v in ipairs(merged) do MUT_LIST[i] = v end
