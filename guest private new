    if _invisState.active then return false end
    local char = GS.svc.Players.LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local realHrp = char:FindFirstChild("HumanoidRootPart")
    if not realHrp then return false end
    local cam = GS.svc.Workspace.CurrentCamera  -- FIX: guard nil camera
    if not cam then return false end

    local tmp = Instance.new("Model")
    char.Parent = tmp
    local cloneHrp = realHrp:Clone()
    cloneHrp.Parent = char
    char.PrimaryPart = cloneHrp
    char.Parent = GS.svc.Workspace
    realHrp.Parent = cam
    cloneHrp.CFrame = realHrp.CFrame

    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("Weld") or v:IsA("Motor6D") then
            if v.Part0 == realHrp then v.Part0 = cloneHrp end
            if v.Part1 == realHrp then v.Part1 = cloneHrp end
        end
    end
    tmp:Destroy()

    _invisState.active = true
    _invisState.cloneHrp = cloneHrp
    _invisState.realHrp = realHrp
    _G.invisibleStealEnabled = true

    _invisState.conn = GS.svc.RunService.PreSimulation:Connect(function()
        if not _invisState.active then return end
        local base = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if not base then return end
        local cf = base.CFrame - Vector3.new(0, depth(), 0)
        realHrp.CFrame = cf * CFrame.Angles(math.rad(angle()), 0, 0)
        realHrp.AssemblyLinearVelocity = base.AssemblyLinearVelocity
        realHrp.CanCollide = false
        if realHrp.Parent ~= GS.svc.Workspace.CurrentCamera then
            realHrp.Parent = GS.svc.Workspace.CurrentCamera
        end
    end)
    return true
