local function destroySentry(sentry)
    if _turretCycleBusy then return false end
    _turretCycleBusy = true
    local finished = false
    task.spawn(function()
        local t0 = tick()
        while sentry and sentry.Parent and tick() - t0 < 6 do
            if LP:GetAttribute("Stealing") then break end
            if not _turretActive then break end
            local char, hrp, hum = getChar()
            if not hrp or not hum or hum.Health <= 0 then break end
            local targetCF = CFrame.new(hrp.Position + hrp.CFrame.LookVector * 4, hrp.Position)
            pcall(function()
                if sentry:IsA("Model") then sentry:PivotTo(targetCF)
                elseif sentry:IsA("BasePart") then sentry.CFrame = targetCF end
            end)
            local bat = findBat()
            if bat then
                if bat.Parent ~= char then pcall(function() hum:EquipTool(bat) end) end
                pcall(function() bat:Activate() end)
            end
            task.wait(0.1)
        end
        finished = true
        _turretCycleBusy = false
    end)
    return finished
end

