    end
    return table.concat(s, "")
end

function util.guidStrip()
    return (util.guid():gsub("%-", ""))
end

function util.clamp(v, lo, hi)
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

function util.lerp(a, b, t)
    return a + (b - a) * t
end

function util.colorLerp(c1, c2, t)
    return Color3.new(
        c1.R + (c2.R - c1.R) * t,
        c1.G + (c2.G - c1.G) * t,
        c1.B + (c2.B - c1.B) * t
    )
end

function util.deepCopy(t)
    if type(t) ~= "table" then return t end
    local o = {}
    for k, v in pairs(t) do
        o[k] = util.deepCopy(v)
    end
    return o
end

function util.tableSize(t)
    if type(t) ~= "table" then return 0 end
    local n = 0
    for _ in pairs(t) do n = n + 1 end
    return n
end

function util.isFinite(n)
    return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

function util.int(n, bound)
    if not util.isFinite(n) then return nil end
    local v = math.floor(n)
    if bound and (v > bound or v < -bound) then
        if v > 0 then v = bound else v = -bound end
    end
    return v
end

function util.scale(n)
    if not util.isFinite(n) then return 0 end
    return util.clamp(n, -10, 10)
end

function util.sanitizeFilename(name)
    if type(name) ~= "string" then name = "config" end
    local s = name:gsub("[^%w%-_ ]", ""):gsub("%s+", "_")
    if s == "" then s = "config" end
    return s:sub(1, 40)
