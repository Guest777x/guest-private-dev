local UNRANKED = 999
local RANK_MUL = 1000
local _nameRank, _mutRank = {}, {}
local _dirty = true
local _haveMut = false
local _lastN, _lastM = -1, -1

local function rebuild()
    for k in pairs(_nameRank) do _nameRank[k] = nil end
    for k in pairs(_mutRank) do _mutRank[k] = nil end
    for i, v in ipairs(LIST) do
        if i >= UNRANKED then break end
        local k = tostring(v):lower()
        if _nameRank[k] == nil then _nameRank[k] = i end
    end
    for i, v in ipairs(MUT_LIST) do
        if i >= UNRANKED then break end
        local k = prio.normMut(v)
        if k and _mutRank[k] == nil then _mutRank[k] = i end
    end
    _haveMut = (next(_mutRank) ~= nil) and (cfg.mutationPriorityEnabled ~= false)
    _dirty = false
    _lastN, _lastM = #LIST, #MUT_LIST
end

function prio.markDirty() _dirty = true end

function prio.score(entryOrName, mutation)
    if _dirty or _lastN ~= #LIST or _lastM ~= #MUT_LIST then rebuild() end
    local nm, mu
    if type(entryOrName) == "table" then
        nm = entryOrName.nameLower or (entryOrName.name and tostring(entryOrName.name):lower())
        if not entryOrName.isWalking then mu = entryOrName.mutLower or entryOrName.mutation end
    else
        nm = entryOrName and tostring(entryOrName):lower()
        mu = mutation
    end
    local nr = (nm and _nameRank[nm]) or UNRANKED
    if nr == UNRANKED then return UNRANKED * RANK_MUL + UNRANKED end
    local mr = UNRANKED
    if _haveMut and mu ~= nil then
        mr = _mutRank[mu]
        if mr == nil then
            local k = prio.normMut(mu)
            mr = (k and _mutRank[k]) or UNRANKED
        end
    end
    return nr * RANK_MUL + mr
end

