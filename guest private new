local function resolvePlotOwner(plot)
    local sign = plot:FindFirstChild("PlotSign")
    if sign then
        local sg = sign:FindFirstChildWhichIsA("SurfaceGui", true)
        local lbl = sg and sg:FindFirstChildWhichIsA("TextLabel", true)
        if lbl then
            local text = (lbl.Text or ""):lower()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP then
                    local dn = (p.DisplayName or ""):lower()
                    local un = (p.Name or ""):lower()
                    if (dn ~= "" and text:find(dn, 1, true)) or (un ~= "" and text:find(un, 1, true)) then
                        return p
                    end
                end
            end
        end
    end
    local Sync = sync.getSynchronizer and sync.getSynchronizer()
    if Sync then
        local okCh, ch = pcall(function() return Sync:Get(plot.Name) end)
        if okCh and ch then
            local okO, owner = pcall(function() return ch:Get("Owner") end)
            if okO and owner then
                return sync.ownerPlayer(owner)
            end
        end
    end
    return nil
end

local function nearestBaseOwner(pos)
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    local fps = _G.GS_BaseFootprints
    if not fps or #fps == 0 then return nil end
    local bestName, bestD = nil, math.huge
    for _, f in ipairs(fps) do
        if f.minX then
            local cx, cz = (f.minX + f.maxX) / 2, (f.minZ + f.maxZ) / 2
            local dx, dz = pos.X - cx, pos.Z - cz
            local d = dx * dx + dz * dz
            if d < bestD then bestD, bestName = d, f.plot end
        end
    end
    if not bestName then return nil end
    local plotInst = plots:FindFirstChild(bestName)
    if not plotInst then return nil end
    return resolvePlotOwner(plotInst)
end

