local function fuzzyMatch(hay, needle)
    if needle == "" then return true end
    if string.find(hay, needle, 1, true) then return true end
    local hi, ni = 1, 1
    while hi <= #hay and ni <= #needle do
        if string.byte(hay, hi) == string.byte(needle, ni) then ni = ni + 1 end
        hi = hi + 1
    end
    return ni > #needle
end

local function runSearch(q)
    q = string.lower(q or "")
    if q ~= "" then
        for id in pairs(tabScrolls) do ensureTab(id) end
    end
    if q == "" then
        restoreMoved()
        searchResults.Visible = false
        srNone.Visible = false
        switchTab(activeTab)
        return
    end
    restoreMoved()
    for _, sc in pairs(tabScrolls) do sc.Visible = false end
    searchResults.Visible = true
    local order = 0
    for _, e in ipairs(searchRegistry) do
        if fuzzyMatch(e.label, q) then
            order = order + 1
            e.row.LayoutOrder = order
            e.row.Parent = searchResults
            searchMoved[#searchMoved + 1] = e
        end
    end
    srNone.Visible = (order == 0)
