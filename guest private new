function GS.safeCall(fn, ...)
    if type(fn) ~= "function" then return false, "not a function" end
    if GS.flags.NoSafeCall then
        return guard.raw(fn, ...)
    end
    local args = table.pack(...)
    local body = function()
        if type(setfenv) == "function" then
            pcall(setfenv, 0, cleanEnv)
        end
        return table.pack(pcall(fn, table.unpack(args, 1, args.n)))
    end
    if type(setfenv) == "function" then
        pcall(setfenv, body, cleanEnv)
    end
    local co = coroutine.create(body)
    local ok, packed = coroutine.resume(co)
    if not ok then return false, packed end
    if type(packed) ~= "table" then return false, "safeCall: target yielded" end
    return table.unpack(packed, 1, packed.n)
end

