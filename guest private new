local function instanceChannels()
    if not cap.connectionScan or not cap.upvalueWalk then return nil end
    local pk = RS:FindFirstChild("Packages")
    local sy = pk and pk:FindFirstChild("Synchronizer")
    local cf = sy and sy:FindFirstChild("Channel")
    if not cf then return nil end

    local map, n = {}, 0
    for _, re in ipairs(cf:GetChildren()) do
        if re:IsA("RemoteEvent") then
            local okC, conns = pcall(getconnections, re.OnClientEvent)
            if okC and type(conns) == "table" then
                for _, conn in ipairs(conns) do
                    local okF, f = pcall(function() return conn.Function end)
                    if okF and type(f) == "function" then
                        local okU, uvs = pcall(debug.getupvalues, f)
                        if okU and type(uvs) == "table" then
                            for _, uv in ipairs(uvs) do
                                if type(uv) == "table" and type(rawget(uv, "CacheTable")) == "table" then
                                    map[re.Name] = uv
                                    n = n + 1
                                    break
                                end
                            end
                        end
                    end
                    if map[re.Name] then break end
                end
            end
        end
    end

    local inWindow = (tick() - _pullT0) < (tonumber(GS.flags._pullTrustWindow) or 15)
    for k, ct in pairs(_pulled) do
        local cur = map[k]
        local curCT = cur and rawget(cur, "CacheTable")
        local function realCount(c)
            if type(c) ~= "table" then return -1 end
            local al = rawget(c, "AnimalList") or rawget(c, "Animals")
            if type(al) ~= "table" then return -1 end
            local c2 = 0
            for _, a in pairs(al) do
                if type(a) == "table" then c2 = c2 + 1 end
            end
            return c2
        end
        if cur == nil then
            map[k] = { CacheTable = ct }
            n = n + 1
        elseif inWindow and realCount(ct) > realCount(curCT) then
            map[k] = { CacheTable = ct }
        end
    end

    if n == 0 then return nil end
    sync._chanInstCount = n
    return map
end

sync.instanceChannels = instanceChannels

local function upvalueWalk()
    if not cap.upvalueWalk or GS.flags.NoUpvalues then return nil end
    local m = getSyncModule()
    if not m then return nil end

    local BUDGET = 30000
    local seen = {}
    local best, bestScore = nil, 0

    local function score(t)
        local withCache, withAL, n = 0, 0, 0
        for _, v in next, t do
            n = n + 1
            if n > 400 then break end
            if type(v) == "table" then
                local c = rawget(v, "CacheTable")
                if type(c) == "table" then
                    withCache = withCache + 1
                    if type(rawget(c, "AnimalList")) == "table" then
                        withAL = withAL + 1
                    end
                end
            end
        end
        return withCache + withAL * 10
    end

    local function scan(v, depth)
        BUDGET = BUDGET - 1
        if BUDGET <= 0 or depth > 7 then return end
        local tv = type(v)
        if tv == "table" then
            if seen[v] then return end
            seen[v] = true
            local n = 0
            for _ in next, v do
                n = n + 1
                if n > 600 then return end
            end
            local s = score(v)
            if s > bestScore then best, bestScore = v, s end
            for _, val in next, v do scan(val, depth + 1) end
        elseif tv == "function" then
            if seen[v] then return end
            seen[v] = true
            local ok, ups = pcall(debug.getupvalues, v)
            if ok and type(ups) == "table" then
                for _, u in next, ups do scan(u, depth + 1) end
            end
        end
    end

    for _, fn in next, m do
        if type(fn) == "function" then pcall(scan, fn, 0) end
    end

    if best and bestScore >= 24 then
        return best
    end
    return nil
end

sync.upvalueWalk = upvalueWalk

local _heapBusy = false
local _heapDone = false
local _heapMissAt = 0

local function heapScan()
    if not cap.heapScan then return nil end
    if _heapBusy then return nil end
    if (tick() - _heapMissAt) < 5 then return nil end
    _heapBusy = true

    local ok, gc = pcall(getgc, true)
    if not ok or type(gc) ~= "table" then
        _heapBusy = false
        _heapMissAt = tick()
        return nil
    end

    local slice = (GS.flags.HeapSliceMs or 4) / 1000
    local lastYield = os.clock()
    local best, bestGuid, bestAnimals, cands = nil, 0, -1, 0

    for i = 1, #gc do
        local v = gc[i]
        if type(v) == "table" then
            pcall(function()
                local guidHits, animals, n = 0, 0, 0
                for k, chan in pairs(v) do
                    n = n + 1
                    if n > 64 then return end
                    if type(k) == "string" and k:match(GUID_PATTERN) and type(chan) == "table" then
                        local ct = rawget(chan, "CacheTable")
                        if type(ct) == "table" then
                            guidHits = guidHits + 1
                            local al = rawget(ct, "AnimalList")
                            if type(al) == "table" then
                                for _, a in pairs(al) do
                                    if type(a) == "table" then animals = animals + 1 end
                                end
                            end
                        end
                    end
                end
                if guidHits >= 3 then
                    cands = cands + 1
                    if guidHits > bestGuid or (guidHits == bestGuid and animals > bestAnimals) then
                        best, bestGuid, bestAnimals = v, guidHits, animals
                    end
                end
            end)
        end
        if (os.clock() - lastYield) >= slice then
            task.wait()
            lastYield = os.clock()
        end
    end

    _heapBusy = false
    if best then
        _heapDone = true
        sync._chanGuids = bestGuid
        sync._chanCands = cands
        sync._chanSource = "heap-validated"
        return best
    else
        _heapMissAt = tick()
        sync._heapMisses = (tonumber(sync._heapMisses) or 0) + 1
        return nil
    end
end

sync.heapScan = heapScan

function sync.heapRescan()
    _heapDone, _heapBusy = false, false
    sync._chanTable = nil
    heapScan()
end

if GS.flags.HeapWarm and cap.heapScan then
    task.spawn(function()
        local t0 = os.clock()
        pcall(heapScan)
        sync._heapWarmMs = (os.clock() - t0) * 1000
    end)
end

local _chanTable = nil
local _chanAt = 0
local _needAt = 0
local _needCache = 0
local _haveCache = 0
local _missAt = 0
local RETRY_COOLDOWN = 3

function sync.findChans()
    local now = tick()

    if (now - _needAt) > 2 then
        local pl = workspace:FindFirstChild("Plots")
        _needCache, _needAt = (pl and #pl:GetChildren() or 0), now
    end

    local need = _needCache
    local complete = (need > 0 and _haveCache >= need)
    if complete and sync._chanSource == "instances"
       and _chanTable and next(_chanTable) ~= nil
       and (now - _chanAt) < 1 then
        return _chanTable
    end

    local m = instanceChannels()
    if m then
        if _chanTable then
            for k, v in pairs(_chanTable) do
                if m[k] == nil then m[k] = v end
            end
        end
        local mn = 0
        for _ in pairs(m) do mn = mn + 1 end
        _chanTable, _chanAt = m, now
        _haveCache = mn
        sync._chanSource = "instances"
        sync._chanHave, sync._chanNeed = mn, need
        return m
    end

    if _chanTable and not looksLikeRegistry(_chanTable) then
        _chanTable = nil
        _haveCache = 0
        _heapDone = false
    end

    if _chanTable and next(_chanTable) ~= nil then
        return _chanTable
    end

    if (tick() - _missAt) < RETRY_COOLDOWN then
        return _chanTable
    end

    local upval = upvalueWalk()
    if upval then
        _chanTable, _chanAt = upval, now
        sync._chanSource = "upvalues"
        return _chanTable
    end

    local heap = heapScan()
    if heap then
        _chanTable, _chanAt = heap, now
        return _chanTable
    end

    _missAt = tick()
    return nil
end

local directCache = setmetatable({}, { __mode = "k" })

local function directChannel(cd)
    if type(cd) ~= "table" then return cd end
    local hit = directCache[cd]
    if hit then return hit end
    local w = {
        Raw = cd,
        Get = function(_, key)
            local ct = rawget(cd, "CacheTable")
            if type(ct) ~= "table" then return nil end
            if key == "AnimalList" or key == "Animals" then
                local al = rawget(ct, "AnimalList") or rawget(ct, "Animals")
                if type(al) == "table" then return al end
                return nil
            end
            return rawget(ct, key)
        end,
        GetTable = function() return rawget(cd, "CacheTable") end,
    }
    directCache[cd] = w
    return w
end

sync.directChannel = directChannel

local SyncSafe
SyncSafe = setmetatable({}, {
    __index = function(_, k)
        if k == "GetAllChannels" then
            return function()
                local t = sync.findChans()
                if not t then return {} end
                local out = {}
                for n, cd in next, t do out[n] = directChannel(cd) end
                return out
            end
