function log.internalError(msg)
    log.ring[log.ringPos] = { t = tick(), msg = tostring(msg) }
    log.ringPos = (log.ringPos % log.ringSize) + 1
    if not GS.flags.SuppressWarnings then
        warn("[GS] " .. tostring(msg))
    end
end

function log.recent(n)
    n = math.clamp(n or 16, 1, log.ringSize)
    local out = {}
    for i = 0, n - 1 do
        local idx = (log.ringPos - 1 - i - 1) % log.ringSize + 1
        local e = log.ring[idx]
        if e then out[#out + 1] = e end
    end
    return out
end

