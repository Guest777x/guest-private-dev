        if type(arr) ~= "table" then
            r.err = "no array"
            return false
        end
        r.apply(arr)
        writeCache(name, table.concat(
            (function()
                local out = {}
                for n in pairs(r.names) do out[#out + 1] = n end
                for id in pairs(r.ids) do out[#out + 1] = "#" .. tostring(id) end
                return out
            end)(),
            "\n"
        ))
        r.err = nil
        return true
    end
    r.has = function(username)
        if not username then return false end
        if r.names[tostring(username):lower()] then return true end
        if r.nI == 0 then return false end
        local p = Players:FindFirstChild(username)
        if not p then return false end
        return r.ids[p.UserId] == true
    end
    return r
end

