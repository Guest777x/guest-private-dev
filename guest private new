local function pickPlayerUnderRay(ray)
    local hitbox = 8
    local bestPlayer, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local v = hrp.Position - ray.Origin
                local along = v:Dot(ray.Direction)
                if along > 0 then
                    local closest = ray.Origin + ray.Direction * along
                    local perp = (hrp.Position - closest).Magnitude
                    if perp <= hitbox and along < bestDist then
                        bestDist = along
                        bestPlayer = p
                    end
                end
            end
        end
    end
    return bestPlayer
end

