    local _, hrp, hum = getChar()
    if not hrp or not hum then
        mov._isFlying = false
        _G.GS_TpActive = false
        return false
    end

    local currentIdx = 1
    local deadline = tick() + 12
    local conn
    local alive = true

    local function stop()
        alive = false
        if conn then conn:Disconnect(); conn = nil end
        _G.GS_TpActive = false
        mov._isFlying = false
    end

    conn = RunService.Heartbeat:Connect(function(dt)
        if not alive then return end
        local c, h2, hum2 = getChar()
        if not c or not h2 or not hum2 or hum2.Health <= 0 then stop() return end
        if _G.GS_CancelTp then stop() return end
        if tick() > deadline then stop() return end

        local target = route[currentIdx]
        local delta = target - h2.Position
        local dist = delta.Magnitude

        if dist < 3 then
            currentIdx = currentIdx + 1
            if currentIdx > #route then
                stop()
                if onArrive then pcall(onArrive) end
                return
            end
            target = route[currentIdx]
            delta = target - h2.Position
            dist = delta.Magnitude
        end

        local spd = speedFor()
        if dist > 0.1 then
            h2.AssemblyLinearVelocity = delta.Unit * spd
        else
            h2.AssemblyLinearVelocity = Vector3.zero
        end
    end)

