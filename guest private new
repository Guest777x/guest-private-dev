local function segAABB(ax, az, bx, bz, x0, z0, x1, z1)
    local dx, dz = bx - ax, bz - az
    local tmin, tmax = 0, 1
    if math.abs(dx) < 1e-6 then
        if ax < x0 or ax > x1 then return false end
    else
        local t1, t2 = (x0 - ax) / dx, (x1 - ax) / dx
        if t1 > t2 then t1, t2 = t2, t1 end
        tmin = math.max(tmin, t1)
        tmax = math.min(tmax, t2)
        if tmin > tmax then return false end
    end
    if math.abs(dz) < 1e-6 then
        if az < z0 or az > z1 then return false end
    else
        local t1, t2 = (z0 - az) / dz, (z1 - az) / dz
        if t1 > t2 then t1, t2 = t2, t1 end
        tmin = math.max(tmin, t1)
        tmax = math.min(tmax, t2)
        if tmin > tmax then return false end
    end
    return true
end

local function planRoute(fromPos, dst, cruiseY)
    cruiseY = cruiseY or (fromPos.Y - 1)
    local MIN_X = math.min(fromPos.X, dst.X) - 30
    local MAX_X = math.max(fromPos.X, dst.X) + 30
    local MIN_Z = math.min(fromPos.Z, dst.Z) - 30
    local MAX_Z = math.max(fromPos.Z, dst.Z) + 30
    local CELL = 8
    local cols = math.ceil((MAX_X - MIN_X) / CELL) + 1
    local rows = math.ceil((MAX_Z - MIN_Z) / CELL) + 1
    if cols * rows > 12000 then
        return { dst }
    end

    local fps = mov.baseFootprints
    local obs = mov.obstacles
    local dstPlotName
    for _, f in ipairs(fps) do
        if dst.X >= f.minX and dst.X <= f.maxX and dst.Z >= f.minZ and dst.Z <= f.maxZ then
            dstPlotName = f.plot
            break
        end
    end

    local function cellIdx(ci, cj)
        return (cj - 1) * cols + ci
    end
    local function wx(ci) return MIN_X + (ci - 1) * CELL + CELL * 0.5 end
    local function wz(cj) return MIN_Z + (cj - 1) * CELL + CELL * 0.5 end

    local blocked = {}
    local function stamp(x0, z0, x1, z1)
        local ci0 = math.clamp(math.floor((x0 - MIN_X) / CELL) + 1, 1, cols)
        local ci1 = math.clamp(math.floor((x1 - MIN_X) / CELL) + 1, 1, cols)
        local cj0 = math.clamp(math.floor((z0 - MIN_Z) / CELL) + 1, 1, rows)
        local cj1 = math.clamp(math.floor((z1 - MIN_Z) / CELL) + 1, 1, rows)
        for cj = cj0, cj1 do
            local base = (cj - 1) * cols
            for ci = ci0, ci1 do
                blocked[base + ci] = true
            end
        end
    end

    for _, f in ipairs(fps) do
        if f.plot ~= dstPlotName and f.minX then
            stamp(f.minX, f.minZ, f.maxX, f.maxZ)
        end
    end
    for _, o in ipairs(obs) do
        local cx, cz, r = o.center.X, o.center.Z, o.radius
        if (fromPos - o.center).Magnitude > r and (dst - o.center).Magnitude > r then
            stamp(cx - r, cz - r, cx + r, cz + r)
        end
    end

    local sCi = math.clamp(math.floor((fromPos.X - MIN_X) / CELL) + 1, 1, cols)
    local sCj = math.clamp(math.floor((fromPos.Z - MIN_Z) / CELL) + 1, 1, rows)
    local gCi = math.clamp(math.floor((dst.X - MIN_X) / CELL) + 1, 1, cols)
    local gCj = math.clamp(math.floor((dst.Z - MIN_Z) / CELL) + 1, 1, rows)

    local function freeNear(ci, cj)
        if not blocked[cellIdx(ci, cj)] then return ci, cj end
        for r = 1, 6 do
            for dj = -r, r do
                for di = -r, r do
                    if math.abs(di) == r or math.abs(dj) == r then
                        local ni, nj = ci + di, cj + dj
                        if ni >= 1 and ni <= cols and nj >= 1 and nj <= rows
                           and not blocked[cellIdx(ni, nj)] then
                            return ni, nj
                        end
                    end
                end
            end
        end
        blocked[cellIdx(ci, cj)] = false
        return ci, cj
    end

    sCi, sCj = freeNear(sCi, sCj)
    gCi, gCj = freeNear(gCi, gCj)

    local OPEN, CLOSED, G, F, PARENT = {}, {}, {}, {}, {}
    local sIdx, gIdx = cellIdx(sCi, sCj), cellIdx(gCi, gCj)
    local function h(ci, cj)
        local dx, dz = math.abs(ci - gCi), math.abs(cj - gCj)
        return CELL * ((dx + dz) + (1.414 - 2) * math.min(dx, dz))
    end
    G[sIdx] = 0
    F[sIdx] = h(sCi, sCj)
    OPEN[sIdx] = true

    local NEIGHBORS = {
        { 1, 0, CELL }, { -1, 0, CELL }, { 0, 1, CELL }, { 0, -1, CELL },
        { 1, 1, CELL * 1.414 }, { 1, -1, CELL * 1.414 },
        { -1, 1, CELL * 1.414 }, { -1, -1, CELL * 1.414 },
    }

    local loops = 0
    while true do
        loops = loops + 1
        if loops > 4000 then break end
        local u, best = nil, math.huge
        for idx in pairs(OPEN) do
            if F[idx] < best then best, u = F[idx], idx end
        end
        if not u then break end
        if u == gIdx then break end
        OPEN[u] = nil
        CLOSED[u] = true
        local uj = math.floor((u - 1) / cols)
        local ui = u - uj * cols
        uj = uj + 1
        for _, n in ipairs(NEIGHBORS) do
            local ni, nj = ui + n[1], uj + n[2]
            if ni >= 1 and ni <= cols and nj >= 1 and nj <= rows then
                local nIdx = cellIdx(ni, nj)
                if not blocked[nIdx] and not CLOSED[nIdx] then
                    local tentative = (G[u] or 0) + n[3]
                    if not G[nIdx] or tentative < G[nIdx] then
                        PARENT[nIdx] = u
                        G[nIdx] = tentative
                        F[nIdx] = tentative + h(ni, nj)
                        OPEN[nIdx] = true
                    end
                end
            end
        end
    end

    local rev, cc = {}, gIdx
    while cc do
        rev[#rev + 1] = cc
        cc = PARENT[cc]
    end
    if #rev <= 1 then return { dst } end

    local route = {}
    for i = #rev - 1, 1, -1 do
        local cj = math.floor((rev[i] - 1) / cols)
        local ci = rev[i] - cj * cols
        cj = cj + 1
        route[#route + 1] = Vector3.new(wx(ci), cruiseY, wz(cj))
    end
    route[#route + 1] = dst
    return route
end

mov.planRoute = planRoute

function mov.computeRoute(part, fromPos)
    if not part or not part.Parent then return nil end
    local exactPos = part.Position
    local signPart = mov.getClosestBaseSign(part)
    local isSecondFloor = exactPos.Y > 10

    local targetBasePos
    if signPart then
        local intoBase = mov.getSignInwardDir(signPart)
        local standOff = 5
        local p = signPart.Position + intoBase * standOff
        local floorY
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = { LP.Character }
        local ground = Workspace:Raycast(Vector3.new(p.X, exactPos.Y + 8, p.Z), Vector3.new(0, -30, 0), rp)
        floorY = ground and ground.Position.Y or exactPos.Y
        targetBasePos = Vector3.new(p.X, floorY + 3, p.Z)
    else
        targetBasePos = Vector3.new(exactPos.X, exactPos.Y + 2.5, exactPos.Z)
    end

    local cruiseY = isSecondFloor and (exactPos.Y + 4) or (targetBasePos.Y + 2)
    local route = planRoute(fromPos, targetBasePos, cruiseY)
    return targetBasePos, route, signPart, isSecondFloor
end

