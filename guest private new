local function refreshBrainrotESP()
    if not cfg.brainrotESP then return end
    local cache = GS.steal and GS.steal.AllAnimalsCache
    if not cache or #cache == 0 then return end

    local ranked = {}
    for i, a in ipairs(cache) do
        if a.genValue and a.genValue >= MIN_ESP_GEN and not a.isWalking then
            ranked[#ranked + 1] = { e = a, s = prio.score(a), i = i }
        end
    end
    table.sort(ranked, function(x, y)
        if x.s ~= y.s then return x.s < y.s end
        return x.i < y.i
    end)
    local rankByUid = {}
    for i = 1, math.min(#ranked, 3) do
        rankByUid[ranked[i].e.uid] = i
    end

    local seen = {}
    local _, hrp = LP.Character, LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local rootPos = hrp and hrp.Position

    for _, data in ipairs(cache) do
        if data.genValue and data.genValue >= MIN_ESP_GEN and not data.isWalking then
            seen[data.uid] = true
            local color = RANK_COLORS[rankByUid[data.uid]] or DEFAULT_ESP_COLOR
            local existing = brainrotBillboards[data.uid]
            if existing and existing.bb and existing.bb.Parent then
                if existing.color ~= color then
                    existing.color = color
                    existing.st.Color = color
                    existing.nm.TextColor3 = color
                    if existing.badge then existing.badge.BackgroundColor3 = color end
                end
            else
                local adornee = esp.findAdornee(data)
                if adornee and (not rootPos or (adornee.Position - rootPos).Magnitude <= 3000) then
                    local bb, st, nm, badge = createBillboard(data, color)
                    bb.Adornee = adornee
                    bb.Parent = adornee
                    brainrotBillboards[data.uid] = { bb = bb, st = st, nm = nm, badge = badge, color = color }
                end
            end
        end
    end

    for uid, e in pairs(brainrotBillboards) do
        if not seen[uid] then
            if e.bb and e.bb.Parent then e.bb:Destroy() end
            brainrotBillboards[uid] = nil
        end
    end
end

function esp.clearBrainrotESP()
    for _, e in pairs(brainrotBillboards) do
        if e.bb then pcall(function() e.bb:Destroy() end) end
    end
    brainrotBillboards = {}
    esp._brainrotBills = brainrotBillboards
end

