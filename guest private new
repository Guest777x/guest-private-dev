function rose.watchNearest(container)
    if _G.GS_NearestCleanup then pcall(_G.GS_NearestCleanup) end
    local conns = {}
    local function connect(sig, fn) conns[#conns + 1] = sig:Connect(fn) end
    local function hook(gui)
        if not gui:IsA("ScreenGui") then return end
        local function style(o)
            if o:IsA("Frame") and o.Name == "CurrentTargetHUD" then
                task.defer(function()
                    if o.Parent then rose.panel(o) end
                end)
            end
        end
        for _, o in ipairs(gui:GetDescendants()) do style(o) end
        connect(gui.DescendantAdded, style)
    end
    for _, gui in ipairs(container:GetChildren()) do hook(gui) end
    connect(container.ChildAdded, hook)
    _G.GS_NearestCleanup = function()
        for _, c in ipairs(conns) do c:Disconnect() end
        table.clear(conns)
    end
end

