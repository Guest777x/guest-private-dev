function ui.slider(parent, opts, order)
    opts = opts or {}
    local lo = tonumber(opts.min) or 0
    local hi = tonumber(opts.max) or 100
    if hi < lo then lo, hi = hi, lo end
    local decimals = math.clamp(math.floor(tonumber(opts.decimals) or 0), 0, 6)
    local precision = 10 ^ decimals
    local step = tonumber(opts.step)
    if not step or step <= 0 then step = 1 / precision end
    local valueFormat = opts.format or ("%." .. decimals .. "f")

    local row = ui.new("Frame", parent, {
        Size = UDim2.new(1, 0, 0, 46),
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        LayoutOrder = order or 0,
    })
    ui.corner(row, 6)
    ui.new("TextLabel", row, {
        Size = UDim2.new(1, -80, 0, 17),
        Position = UDim2.new(0, 10, 0, 3),
        BackgroundTransparency = 1,
        Text = opts.text or "",
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = theme.TextPrimary,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local valLbl = ui.new("TextLabel", row, {
        Size = UDim2.new(0, 68, 0, 17),
        Position = UDim2.new(1, -76, 0, 3),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = theme.Accent1,
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local track = ui.new("Frame", row, {
        Size = UDim2.new(1, -20, 0, 4),
        Position = UDim2.new(0, 10, 0, 31),
        BackgroundColor3 = theme.SurfaceHighlight,
        BorderSizePixel = 0,
    })
    ui.round(track)
    local fill = ui.new("Frame", track, {
        BackgroundColor3 = theme.Accent1,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
    })
    ui.round(fill)
    local knob = ui.new("Frame", track, {
        Size = UDim2.new(0, 11, 0, 11),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.TextPrimary,
        BorderSizePixel = 0,
    })
    ui.round(knob)

    local current = tonumber(opts.default) or lo
    local function paint(v)
        v = util.clamp(v, lo, hi)
        current = v
        local p = (hi > lo) and ((v - lo) / (hi - lo)) or 0
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, 0, 0.5, 0)
        valLbl.Text = string.format(valueFormat, v)
    end

    local function setValue(v, notify)
        if type(v) ~= "number" or v ~= v then return end
        v = util.clamp(v, lo, hi)
        v = lo + math.floor((v - lo) / step + 0.5) * step
        v = util.clamp(math.floor(v * precision + 0.5) / precision, lo, hi)
        if v == current then return end
        paint(v)
        if notify and opts.callback then pcall(opts.callback, v) end
    end

    paint(current)

    local dragging
    local conns = {}

    local function trackAt(x)
        local tw = track.AbsoluteSize.X
        if tw <= 0 then return end
        local rel = util.clamp((x - track.AbsolutePosition.X) / tw, 0, 1)
        setValue(lo + rel * (hi - lo), false)
    end

    conns[#conns + 1] = track.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        trackAt(input.Position.X)
    end)

    conns[#conns + 1] = UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        trackAt(input.Position.X)
    end)

    conns[#conns + 1] = UIS.InputEnded:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = false
        if opts.callback then pcall(opts.callback, current) end
        if opts.saveOnRelease then GS.config.save() end
    end)

    GS.onDestroy(function()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    end)

    return row, setValue, function() return current end
end

