                if v.Part1 == _invisState.cloneHrp then v.Part1 = _invisState.realHrp end
            end
        end
        if _invisState.cloneHrp then
            local at = _invisState.cloneHrp.CFrame
            _invisState.cloneHrp:Destroy()
