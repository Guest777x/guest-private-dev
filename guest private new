function steal.resolveTarget()
    local all = steal.AllAnimalsCache
    if not all or #all == 0 then return nil end

    local m = manualTarget()
    if m then return m end

    if cfg.stealNearest then
        local _, hrp = LP.Character, LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local best, bestD = nil, math.huge
        local hp = hrp.Position
        for _, a in ipairs(all) do
            if stealable(a) then
                local part = GS.esp and GS.esp.findAdornee and GS.esp.findAdornee(a)
                if part then
                    local d = (hp - part.Position).Magnitude
                    if d < bestD then bestD, best = d, a end
                end
            end
        end
        return best
    end

    if cfg.stealBest then
        for _, a in ipairs(all) do
            if stealable(a) then return a end
        end
        return nil
    end

    if cfg.stealPriority then
        local best, bestScore = nil, math.huge
        for _, a in ipairs(all) do
            if stealable(a) then
                local s = prio.score(a)
                if s < bestScore then bestScore, best = s, a end
            end
        end
        if best and bestScore < 999999 then return best end
        return nil
    end

    if cfg.stealHighest then
        for _, a in ipairs(all) do
            if stealable(a) then return a end
        end
        return nil
    end

    for _, a in ipairs(all) do
        if stealable(a) then return a end
    end
    return nil
end

function steal.findNearestPrompt(target)
    local _, hrp = LP.Character, LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    target = target or steal.resolveTarget()
    if not target then return nil end
    local radius = cfg.stealRadius or 95
    if target.isWalking then
        local pr = target.prompt
        if pr and pr.Parent and pr.Enabled then
            local model = target.model
            local part = model and model.Parent and model:FindFirstChildWhichIsA("BasePart")
            if part then
                local p = part.Position
                local hp = hrp.Position
                if math.sqrt((p.X - hp.X) ^ 2 + (p.Z - hp.Z) ^ 2) <= radius then
                    return pr
                end
            end
        end
        return nil
    end
    local prompt = steal.findPrompt(target)
    if not prompt then return nil end
    local d = steal.promptDistance(prompt)
    if d and d > radius then return nil end
    return prompt
end

