}

local pendingGrief = {}
local currentGriefStealInfo = nil
local stealEndedAt = 0

local function getStealInfo()
    local stealingIndex = LP:GetAttribute("StealingIndex")
    if not stealingIndex then return nil end
    local Sync = sync.getSynchronizer and sync.getSynchronizer()
    if not Sync then return nil end
    local animalsData
    pcall(function()
        animalsData = require(svc.ReplicatedStorage:WaitForChild("Datas", 10):WaitForChild("Animals", 10))
    end)
    local best, bestGen = nil, -1
    for _, ch in pairs(Sync:GetAllChannels()) do
        local ok, ct = pcall(function() return ch:GetTable() end)
        if ok and type(ct) == "table" then
            local al = rawget(ct, "AnimalList") or rawget(ct, "Animals")
            if type(al) == "table" then
                for _, entry in pairs(al) do
                    if type(entry) == "table" and tostring(entry.Index) == tostring(stealingIndex) then
                        local gv = GS.steal.computeGen(entry.Index, entry.Mutation, entry.Traits)
                        if gv > bestGen then
                            bestGen = gv
                            best = {
                                displayName = (animalsData and animalsData[entry.Index]
                                                and animalsData[entry.Index].DisplayName)
                                                or entry.Index,
                                mutation = entry.Mutation or "None",
                                genValue = gv,
                                genText = GS.steal.genText(gv),
                            }
                        end
                    end
                end
            end
        end
    end
    return best
end

local function flushPending()
    pendingGrief = {}
    currentGriefStealInfo = nil
end

local function queueGrief(griefer, item)
    if cfg.griefDetectorEnabled == false then return end
    if type(item) ~= "string" or item == "" or item:sub(1, 1) == "#" then return end
    local isStealing = LP:GetAttribute("Stealing") == true
    local inGrace = (tick() - stealEndedAt) < 0.5
    if not isStealing and not inGrace then return end
    if isStealing and not currentGriefStealInfo then
        currentGriefStealInfo = getStealInfo()
    end
    for _, e in ipairs(pendingGrief) do
        if e.griefer == griefer and e.item == item then return end
    end
    local aj = roster.autojoinerName(griefer)
    table.insert(pendingGrief, { griefer = griefer, item = item, autojoiner = aj })

    pcall(function()
        local card = GS.build and GS.build.griefCard
        if card and card.title then
            card.title.Text = tostring(griefer or "Unknown")
            card.title.TextColor3 = GS.theme.Error
            local detail = tostring(item or "Unknown item")
            if currentGriefStealInfo and currentGriefStealInfo.displayName then
                detail = detail .. "  \u{2022}  target: " .. tostring(currentGriefStealInfo.displayName)
            end
            card.detail.Text = detail
        end
    end)

    pcall(function()
        local text = tostring(griefer or "Unknown") .. " used " .. tostring(item or "an item")
        if currentGriefStealInfo and currentGriefStealInfo.displayName then
            text = text .. " (target: " .. currentGriefStealInfo.displayName .. ")"
        end
        svc.StarterGui:SetCore("SendNotification", {
            Title = "GRIEF DETECTED",
            Text = text,
            Duration = 6,
        })
    end)

    _G.GS_LastGriefEvent = {
        griefer = griefer,
        item = item,
        autojoiner = aj,
        stealInfo = currentGriefStealInfo,
        time = (function()
            local ok, s = pcall(function() return os.date("%H:%M:%S") end)
            return ok and s or ""
        end)(),
    }
end

