function guard.call(fn, ...)
    if type(fn) ~= "function" then return false, "not a function" end
    local packed = table.pack(pcall(fn, ...))
    if not packed[1] then
        return false, packed[2]
    end
    return true, table.unpack(packed, 2, packed.n)
end

function guard.raw(fn, ...)
    if type(fn) ~= "function" then return false, "not a function" end
    local packed = table.pack(pcall(fn, ...))
    if not packed[1] then return false, packed[2] end
    return true, table.unpack(packed, 2, packed.n)
end

function guard.spawn(fn, ...)
    local packed = table.pack(...)
    task.spawn(function()
        local ok, err = pcall(fn, table.unpack(packed, 1, packed.n))
        if not ok then
            GS.log.internalError(tostring(err))
        end
    end)
end

function guard.defer(fn, ...)
    local packed = table.pack(...)
    task.defer(function()
        local ok, err = pcall(fn, table.unpack(packed, 1, packed.n))
        if not ok then
            GS.log.internalError(tostring(err))
        end
    end)
end

function guard.heartbeatLoop(name, body, interval)
    if type(body) ~= "function" then return end
    interval = interval or 0.1
    local conn
    conn = svc.RunService.Heartbeat:Connect(function(dt)
        if not GS.env.loaded then return end
        local ok, err = pcall(body, dt)
        if not ok then
            GS.log.internalError(name .. ": " .. tostring(err))
        end
    end)
    return conn
end

