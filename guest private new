local function _recolorAllCustom(map)
    if not map then return end
    local function remap(c)
        if not c then return c end
        local best, bestDist = c, 0.04
        for old, new in pairs(map) do
            local dr = math.abs(c.R - old.R)
            local dg = math.abs(c.G - old.G)
            local db = math.abs(c.B - old.B)
            if (dr + dg + db) < bestDist then
                best, bestDist = new, dr + dg + db
            end
        end
        return best
    end
    for _, fn in ipairs(_recolorHooks) do
        pcall(fn, remap)
    end
end

