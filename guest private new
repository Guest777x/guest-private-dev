end)

local gearHolderCache = {}

local function getGearHolder(gearName)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild(gearName) then
            gearHolderCache[gearName] = { name = p.Name, t = tick() }
            return p
        end
    end
    local c = gearHolderCache[gearName]
    if c and (tick() - c.t) < 5 then
