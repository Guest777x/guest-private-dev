            end
        end
        local m = getSyncModule()
        if not m then return nil end
        local v = m[k]
        if type(v) ~= "function" then return v end
        return function(_, ...)
            local ok, r = pcall(v, m, ...)
            if not ok then return nil end
            return r
        end
    end,
})
