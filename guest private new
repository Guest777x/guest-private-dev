local function baseBoxFromPlot(plot)
    if not plot then return nil end
    local pods = plot:FindFirstChild("AnimalPodiums")
    local mnF, mxF = math.huge, -math.huge
    if pods then
        for _, pod in ipairs(pods:GetChildren()) do
            local base = pod:FindFirstChild("Base")
            local spawn = base and base:FindFirstChild("Spawn")
            if spawn and spawn:IsA("BasePart") then
                if spawn.Position.Y < mnF then mnF = spawn.Position.Y end
                if spawn.Position.Y > mxF then mxF = spawn.Position.Y end
            end
        end
    end
    local haveFloor = mnF ~= math.huge
    local floorY = haveFloor and (mnF - 4) or nil
    local roofY = haveFloor and (mxF + 16) or nil

    local mnx, mxx, mnz, mxz = math.huge, -math.huge, math.huge, -math.huge
    local n = 0
    for _, d in ipairs(plot:GetDescendants()) do
        if d:IsA("BasePart") and d.Anchored and d.CanCollide
           and math.abs(d.Position.X) < 50000 and math.abs(d.Position.Z) < 50000
           and not inPlotFolder(d, "AnimalPodiums", plot)
           and not inPlotFolder(d, "CashPad", plot)
           and not inPlotFolder(d, "Cash", plot)
           and not inPlotFolder(d, "Laser", plot)
           and d.Name ~= "LaserHitbox" then
            local q, s, cf = d.Position, d.Size, d.CFrame
            local hx = (math.abs(cf.RightVector.X) * s.X + math.abs(cf.UpVector.X) * s.Y + math.abs(cf.LookVector.X) * s.Z) * 0.5
            local hy = (math.abs(cf.RightVector.Y) * s.X + math.abs(cf.UpVector.Y) * s.Y + math.abs(cf.LookVector.Y) * s.Z) * 0.5
            local hz = (math.abs(cf.RightVector.Z) * s.X + math.abs(cf.UpVector.Z) * s.Y + math.abs(cf.LookVector.Z) * s.Z) * 0.5
            if (not haveFloor) or ((q.Y + hy >= floorY - 3) and (q.Y - hy <= roofY + 5)) then
                mnx = math.min(mnx, q.X - hx)
                mxx = math.max(mxx, q.X + hx)
                mnz = math.min(mnz, q.Z - hz)
                mxz = math.max(mxz, q.Z + hz)
                n = n + 1
            end
        end
    end
    if n < 3 then return nil end
    local ok, cf, sz = pcall(function() return plot:GetBoundingBox() end)
    if not ok or not cf then return nil end
    return mnx, mxx, mnz, mxz, floorY or (cf.Position.Y - 4), roofY or (cf.Position.Y + 16)
end

