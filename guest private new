local StealData = setmetatable({}, { __mode = "k" })
local isAutoStealing = false
local _stealStart = 0
local _stealProgress = 0
local _holdEpoch = 0

function steal.isStealing()
    return isAutoStealing
end

function steal.stealProgress()
    return _stealProgress
end

function steal.execute(prompt, heldUid, preHold)
    if not prompt then return false end
    if isAutoStealing then return false end
    local dist, _ = steal.promptDistance(prompt)
    if dist and dist > (cfg.stealRadius or 95) and preHold ~= true then
        return false
    end

    local data = StealData[prompt]
    if not data then
        data = grabCallbacks(prompt)
        data.ready = true
        local hasFPP = type(fireproximityprompt) == "function"
                    or (type(syn) == "table" and type(syn.fireproximityprompt) == "function")
                    or cap.fireproximityprompt
        if #data.hold > 0 and (#data.trigger > 0 or hasFPP) then
            StealData[prompt] = data
        end
    end
    if not data.ready then return false end
    data.ready = false

    isAutoStealing = true
    _stealStart = tick()

    task.spawn(function()
        local ok, err = pcall(function()
            local oldDuration = prompt.HoldDuration
            prompt.HoldDuration = 0

            local beginT, inherited = 0, false
            local holdAge = _holdEpoch > 0 and (tick() - _holdEpoch) or math.huge
            if prompt.Enabled and _holdEpoch > 0 and holdAge <= 1.25 then
                beginT, inherited = _holdEpoch, true
            else
                for _, fn in ipairs(data.hold) do
                    task.spawn(function() pcall(fn) end)
                end
                beginT = prompt.Enabled and tick() or 0
                if beginT > 0 and #data.hold > 0 then _holdEpoch = beginT end
            end

            local beganOk = (inherited or #data.hold > 0)
            local duration = cfg.stealDuration
            if not duration then
                local serverDur = tonumber(oldDuration)
                duration = ((serverDur and serverDur > 0.1 and serverDur) or 1.3) + 0.0
            end
            local maxHold = duration + 1.3

            local t0 = inherited and beginT or tick()
            local holdAbsStart = tick()
            if inherited then _stealStart = beginT end

            local ragStart = steal.ragdollUntil()
            local postGrace = ((ragStart > 0) and 0.3 or 0)
            local abort, grabbed, recycle, didEnter = false, false, false, false
            local clearFireUntil, lastCommitT, commitN = 0, 0, 0
            local eligSince, commitGraceUntil, tpHold = 0, 0, false
            local tpWasBlk, wasDis, disAt = false, false, nil
            local carryChkT, carryFlag, carryLastT, bankT, campChkT = 0, false, 0, 0, 0
            local promptGone, goneAt, goneConn = false, nil, nil
            local activePrompt, activeData = prompt, data

            local function petDistanceNow()
                local _, hrp = LP.Character, LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return nil end
                local _, d3 = steal.promptDistance(activePrompt)
                return d3
            end

            if heldUid then
                local plot, slot = heldUid:match("^(.-)_([^_]+)$")
                local plots = Workspace:FindFirstChild("Plots")
                local plotInst = plots and plot and plots:FindFirstChild(plot)
                local pods = plotInst and plotInst:FindFirstChild("AnimalPodiums")
                local pod = pods and slot and pods:FindFirstChild(slot)
                if pod then
                    goneConn = pod.DescendantAdded:Connect(function(desc)
                        if promptGone and desc:IsA("ProximityPrompt")
                           and tostring(desc.ActionText or ""):find("Steal") then
                            activePrompt = desc
                            activeData = grabCallbacks(desc)
                            pcall(function() desc.HoldDuration = 0 end)
                            for _, fn in ipairs(activeData.hold) do
                                task.spawn(function() pcall(fn) end)
                            end
                            beginT = desc.Enabled and tick() or 0
                            if beginT > 0 and #activeData.hold > 0 then _holdEpoch = beginT end
                            beganOk = #activeData.hold > 0
                            wasDis, disAt, bankT = false, nil, 0
                            promptGone, goneAt = false, nil
                            _stealStart = tick()
                            t0, commitN, lastCommitT, recycle = tick(), 0, 0, false
                        end
                    end)
                end
            end

            while true do
                if _G.GS_ManualTarget and heldUid and _G.GS_ManualTarget.uid
                   and _G.GS_ManualTarget.uid ~= heldUid then
                    abort = true
                    break
                end
                if LP:GetAttribute("Stealing") then grabbed = true; break end
                if goneConn and not activePrompt.Parent and not promptGone then
                    promptGone = true
                    goneAt = tick()
                end

                if promptGone then
                    if bankT == 0 or (tick() - bankT) > 2.5 then
                        if steal.fireHoldForced(activePrompt, activeData) then
                            bankT = tick()
                            _holdEpoch = bankT
                        end
                    end
                    if (tick() - goneAt) > 6.5 then break end
                    t0 = t0 + 0.12
                    task.wait(0.12)
                else
                    local shouldBreak = false

                    if activePrompt.Parent and not activePrompt.Enabled then
                        if not disAt then disAt = tick() end
                        if (tick() - carryChkT) > 0.25 then
                            carryChkT = tick()
                            if #activeData.hold == 0 then activeData = grabCallbacks(activePrompt) end
                            local cnow = false
                            if _G.GS_IsBeingStolen then
                                for _, sa in ipairs(steal.AllAnimalsCache) do
                                    if sa and sa.uid == heldUid then
                                        local cok, cv = pcall(_G.GS_IsBeingStolen, sa)
                                        cnow = cok and cv == true
                                        break
                                    end
                                end
                            end
                            if cnow then carryLastT = tick() end
                            carryFlag = cnow or (tick() - carryLastT) < 1.0
                        end
                        if bankT > 0 and (tick() - bankT) > 2.5 then bankT = 0 end
                        if bankT == 0 then
                            if steal.fireHoldForced(activePrompt, activeData) then
                                bankT = tick()
                                _holdEpoch = bankT
                            end
                        end
                        if not carryFlag and (tick() - math.max(disAt, carryLastT)) > 3 then
                            shouldBreak = true
                        end
                        wasDis = true
                        t0, commitN, lastCommitT, recycle = tick(), 0, 0, false
                        holdAbsStart = holdAbsStart + (task.wait(0.03) or 0.03)
                    elseif wasDis then
                        wasDis, disAt = false, nil
                        activeData = grabCallbacks(activePrompt)
                        local bAge = bankT > 0 and (tick() - bankT) or math.huge
                        if bAge <= 2.3 then
                            beginT = bankT
                            t0 = bankT
                            _stealStart = bankT
                            beganOk = true
                        else
                            for _, fn in ipairs(activeData.hold) do
                                task.spawn(function() pcall(fn) end)
                            end
                            beginT = tick()
                            beganOk = #activeData.hold > 0
                            if beganOk then _holdEpoch = beginT end
                            t0 = tick()
                            _stealStart = tick()
                        end
                        bankT = 0
                        commitN, lastCommitT, recycle = 0, 0, false
                        eligSince = tick() - 0.3
                        clearFireUntil = math.max(clearFireUntil, tick() + 0.5)
                    end

                    if not shouldBreak then
                        if not beganOk then _stealStart = tick() end

                        if #activeData.hold == 0 then
                            local rd = grabCallbacks(activePrompt)
                            if #rd.hold > 0 then
                                activeData = rd
                                if not beganOk then
                                    for _, fn in ipairs(rd.hold) do
                                        task.spawn(function() pcall(fn) end)
                                    end
                                    if activePrompt.Enabled then
                                        beginT = tick()
                                        _holdEpoch = beginT
                                    end
                                    beganOk = true
                                    _stealStart = tick()
                                    t0, commitN, lastCommitT, recycle = tick(), 0, 0, false
                                end
                            end
                        end

                        local hrDist = steal.promptDistance(activePrompt)
                        if hrDist and hrDist > (cfg.stealRadius or 95) and not preHold then
                            abort = true
                            break
                        end

                        local now = tick()
                        local nr = steal.ragdollUntil()
                        local remNow = nr - Workspace:GetServerTimeNow()
                        if nr > ragStart + 0.3 and remNow > 0.1 then
                            ragStart = nr
                            t0 = math.max(t0, now + remNow - duration + 0.1)
                            _stealStart = math.max(_stealStart, t0)
                            postGrace = 0.3
                        end

                        local holdDone = (now - t0) >= (duration + postGrace)
                        local ragBlocked = steal.ragdollBlockedNow()
                        if holdDone and ragBlocked then
                            clearFireUntil = now + 0.35
                        end

                        if commitN == 0 and not ragBlocked
                           and (beginT == 0 or (now - beginT) > 2.5)
                           and activePrompt.Parent and activePrompt.Enabled then
                            local rhOk = steal.fireHoldForced(activePrompt, activeData)
                            beginT = tick()
                            _holdEpoch = rhOk and beginT or 0
                            beganOk = #activeData.hold > 0
                            _stealStart = tick()
                            t0 = math.max(t0, tick())
                        end

                        local petDist = petDistanceNow()
                        local petInRange = petDist and petDist <= 10
                        local tpBlocking = _G.GS_TpActive == true
                                           and _G.GS_CurrentTpTarget ~= nil
                                           and _G.GS_CurrentTpTarget.uid == heldUid
                        if tpWasBlk and not tpBlocking then
                            clearFireUntil = math.max(clearFireUntil, now + 0.75)
                        end
                        tpWasBlk = tpBlocking

                        if petInRange and not tpBlocking then
                            if eligSince == 0 then eligSince = now end
                        else
                            eligSince = 0
                        end

                        local snapT = tonumber(_G.GS_BrainrotSnapT) or 0
                        local instaFresh = snapT > 0 and (now - snapT) < 5
                        local settleAnchor = eligSince
                        if instaFresh and snapT > settleAnchor then settleAnchor = snapT end
                        local instaDelay = tonumber(_G.GS_InstaSettle) or 0.35
                        local effDelay = instaFresh and instaDelay or 0.3
                        local settled = (eligSince > 0) and ((now - settleAnchor) >= effDelay)
                        local inCommit = holdDone and not grabbed and not ragBlocked
                                         and petInRange and not tpBlocking and settled
                                         and beginT > 0 and (now - beginT) >= duration
                                         and (now - beginT) <= 2.5
                        tpHold = tpBlocking and not grabbed and commitN == 0 and holdDone
                                 and (now - holdAbsStart) < 8

                        if inCommit and commitN == 0 then
                            lastCommitT, commitN = now, 1
                            steal.fireTrigger(activePrompt, activeData)
                        end

                        if inCommit and not didEnter then
                            didEnter = true
                            local _, shrp = LP.Character, LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                            local v = shrp and shrp.AssemblyLinearVelocity
                            if v and (v.X * v.X + v.Z * v.Z) > 900 then
                                pcall(function()
                                    shrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
                                end)
                            end
                        end

                        if commitN > 0 and not grabbed and (now - lastCommitT) >= 0.4 then
                            recycle = true
                        end

                        commitGraceUntil = 0
                        if not grabbed and (eligSince > 0 or ragBlocked) then
                            local due = 0
                            if commitN == 0 then
                                if eligSince > 0 and not settled then due = settleAnchor + effDelay + 0.06 end
                                if beginT > 0 then
                                    local srvDue = beginT + duration + 0.06
                                    if srvDue > due then due = srvDue end
                                end
                                local hdDue = t0 + duration + postGrace + 0.06
                                if hdDue > due then due = hdDue end
                            else
                                due = lastCommitT + 0.4
                            end
                            if due > 0 then commitGraceUntil = due end
                        end

                        task.wait(0.03)

                        local base = maxHold - (tick() - t0)
                        if base > 0 then
                            _stealProgress = math.clamp((tick() - t0) / duration, 0, 1)
                        else
                            local ext = commitGraceUntil - tick()
                            if tpHold then ext = math.max(ext, (holdAbsStart + 8) - tick()) end
                            _stealProgress = math.clamp(1 - ext / duration, 0, 1)
                        end

                        local exit = not promptGone and not tpHold and not disAt
                                     and ((tick() - t0) >= maxHold or recycle)
                                     and tick() >= clearFireUntil and tick() >= commitGraceUntil
                        if exit then break end
                        if not goneConn and not activePrompt.Parent then break end
                        if (tick() - holdAbsStart > 20) then break end
                    else
                        break
                    end
                end
            end

            if commitN > 0 or not abort then _holdEpoch = 0 end
            if goneConn then pcall(function() goneConn:Disconnect() end) end
            if activePrompt.Parent then activePrompt.HoldDuration = oldDuration end
        end)
        if not ok then
            GS.log.internalError("steal.execute: " .. tostring(err))
        end
        data.ready = true
        isAutoStealing = false
    end)

    return true
end

