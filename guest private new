local function cmdEnabled(cmd)
    local a = cfg.adminAllowedCmds
    return not (a and a[cmd] == false)
end

local function mergedOrder()
    local out, seen = {}, {}
    local saved = cfg.adminCmdOrder
    if type(saved) == "table" then
        for _, c in ipairs(saved) do
            if type(c) == "string" and not seen[c] then
                seen[c] = true
                out[#out + 1] = c
            end
        end
    end
    for _, c in ipairs(ALL_COMMANDS) do
        if not seen[c] then seen[c] = true; out[#out + 1] = c end
    end
    return out
end

local function orderedCommands()
    local out = {}
    for _, c in ipairs(mergedOrder()) do
        if cmdEnabled(c) then out[#out + 1] = c end
    end
    return out
end

admin.orderedCommands = orderedCommands

local function buildCmdSequence(randomize)
    local order = orderedCommands()
    if not randomize or #order < 2 then return order end
    local pinned = (type(cfg.adminCmdPinned) == "table") and cfg.adminCmdPinned or nil
    local seq, freeIdx, pool = {}, {}, {}
    for i, cmd in ipairs(order) do
        if pinned and pinned[cmd] then
            seq[i] = cmd
        else
            seq[i] = false
            freeIdx[#freeIdx + 1] = i
            pool[#pool + 1] = cmd
        end
    end
    local rng = Random.new()
    for i = #pool, 2, -1 do
        local j = rng:NextInteger(1, i)
        pool[i], pool[j] = pool[j], pool[i]
    end
    for k, idx in ipairs(freeIdx) do seq[idx] = pool[k] end
    return seq
end

