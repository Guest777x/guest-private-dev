local function runAdminCommand(target, commandName, selfAction)
    if not target or not commandName then return false end
    if not selfAction and not admin.canUseAdminAction(target) then return false end
    if onCooldown(commandName) then return false end

    local realAdminGui = PlayerGui:FindFirstChild("AdminPanel")
    if realAdminGui then
        local adminPanel = realAdminGui:FindFirstChild("AdminPanel")
        local profiles = adminPanel and adminPanel:FindFirstChild("Profiles")
        local profilesScroll = profiles and profiles:FindFirstChild("ScrollingFrame")
        if profilesScroll then
            local playerBtn = profilesScroll:FindFirstChild(target.Name)
            if playerBtn then
                fireClick(playerBtn)
                task.wait(0.05)
                local content = adminPanel:FindFirstChild("Content")
                local contentScroll = content and content:FindFirstChild("ScrollingFrame")
                local cmdBtn = contentScroll and contentScroll:FindFirstChild(commandName)
                if cmdBtn then
                    fireClick(cmdBtn)
                    return true
                end
            end
        end
    end

    if not adminRemote or not adminRemote.Parent or not adminKey then
        adminRemote, adminKey = admin._resolve()
    end
    if not adminRemote or not adminRemote.Parent or not adminKey then
        return false
    end
    local ok = pcall(function()
        adminRemote:InvokeServer(adminKey, target, commandName)
    end)
    return ok
end

