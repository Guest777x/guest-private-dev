local function trackBullet(obj)
    if not obj.Name:find("SentryBullet") or sentryBulletsHit[obj] then return end
    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
    if not part then return end
    watchPart(part, function()
        if sentryBulletsHit[obj] then return end
        sentryBulletsHit[obj] = true
        local owner = next(sentryOwners) or "Unknown"
        queueGrief(owner, "All Seeing Sentry")
    end)
end

local function trackMissile(child)
    local username = child.Name:match("Missle_(.+)")
    if not username or username == LP.Name then return end
    if not child:IsA("BasePart") then return end
    local function onHit()
        if missileHits[child] then return end
        missileHits[child] = true
        queueGrief(username, "Heatseeker")
    end
    watchPart(child, onHit)
end

local function watchDoge(child)
    local username = child.Name:match("^PlayerName_(.+)_Doge$")
    if not username or username == LP.Name or watchedDoges[child] then return end
    watchedDoges[child] = true
    local parts = child:IsA("BasePart") and { child } or child:GetDescendants()
    for _, part in ipairs(parts) do
        if part:IsA("BasePart") then
            part.Touched:Connect(function(hit)
                local char = LP.Character
                if not char or not hit:IsDescendantOf(char) then return end
                if tick() - dogeLastHit < 2 then return end
                dogeLastHit = tick()
                queueGrief(username, "Attack Doge")
            end)
        end
    end
end

local function onLaserHit()
    if tick() - laserLastHit < 2 then return end
    local holder = getGearHolder("Laser Cape")
    if not holder then return end
    laserLastHit = tick()
    queueGrief(holder.Name, "Laser Cape")
end

Workspace.ChildAdded:Connect(function(child)
    if cfg.griefDetectorEnabled == false then return end
    local _cn = child.Name
    local sentryId = _cn:match("^Sentry_(%d+)$")
    if sentryId then
        local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, tonumber(sentryId))
        sentryOwners[ok and name or "Unknown"] = true
    end
    trackBullet(child)
    if child:IsA("Model") or child:IsA("Folder") then
        child.DescendantAdded:Connect(trackBullet)
    end
    trackMissile(child)
    watchDoge(child)

    if child:IsA("BasePart")
       and math.abs(child.Size.X - 0.9) <= 0.1
       and math.abs(child.Size.Y - 0.9) <= 0.1
       and math.abs(child.Size.Z - 0.9) <= 0.1 then
        local holder = getGearHolder("Paintball Gun")
        if holder then
            local function onPBHit()
                if tick() - paintballLastHit < 2 then return end
                paintballLastHit = tick()
                queueGrief(holder.Name, "Paintball Gun")
            end
            watchPart(child, onPBHit)
        end
    end

    if child:IsA("BasePart")
       and child:FindFirstChildWhichIsA("Attachment")
       and math.abs(child.Size.X - 0.2) <= 0.01
       and math.abs(child.Size.Y - 0.2) <= 0.01
       and math.abs(child.Size.Z - 0.2) <= 0.01
       and not laserDetected[child] then
        local holder = getGearHolder("Laser Cape")
        if holder then
            local _, hrp = getChar()
            if hrp and (child.Position - hrp.Position).Magnitude <= 8 then
                local holderHead = holder.Character and holder.Character:FindFirstChild("Head")
                local myHead = LP.Character and LP.Character:FindFirstChild("Head")
                if holderHead and myHead then
                    local ha = holderHead:FindFirstChildWhichIsA("Attachment")
                    local pa = child:FindFirstChildWhichIsA("Attachment")
                    if ha and pa and ha.WorldPosition == pa.WorldPosition then return end
                end
                laserDetected[child] = true
                onLaserHit()
            end
        end
    end

    if child:IsA("MeshPart") and BODY_PART_SET[child.Name] and tick() - medusaLastHit >= 3 then
        local holder = getGearHolder("Medusa's Head")
        if holder then
            local holderHRP = holder.Character and holder.Character:FindFirstChild("HumanoidRootPart")
            if holderHRP then
                local startT = tick()
                local conn
                conn = RunService.Heartbeat:Connect(function()
                    if tick() - medusaLastHit < 3 or tick() - startT > 1 then conn:Disconnect() return end
                    local char, hrp = getChar()
                    if not hrp or not char then return end
                    local d = holderHRP.Position - hrp.Position
                    if math.sqrt(d.X^2 + d.Z^2) > 17 then return end
                    local localPart = char:FindFirstChild(child.Name)
                    if localPart and (child.Position - localPart.Position).Magnitude <= 2 then
                        medusaLastHit = tick()
                        conn:Disconnect()
                        queueGrief(holder.Name, "Medusa's Head")
                    end
                end)
            end
        end
    end

    if child.Name == "WebRope" and child:IsA("RopeConstraint") then
        local holder = getGearHolder("Web Slinger")
        if holder then
            local conn
            conn = RunService.Heartbeat:Connect(function()
                if not child.Parent then conn:Disconnect() return end
                local char = LP.Character
                if not char then return end
                if (child.Attachment0 and child.Attachment0:IsDescendantOf(char))
                   or (child.Attachment1 and child.Attachment1:IsDescendantOf(char)) then
                    queueGrief(holder.Name, "Web Slinger")
                    conn:Disconnect()
                end
            end)
        end
    end
end)

