function steal.computeGen(index, mutation, traits)
    if not loadDatas() then return 0 end
    local info = _animalsData[index]
    if not info then return 0 end
    local base = info.Generation
    if not base then
        local gameMod = 0
        pcall(function()
            local gd = require(svc.ReplicatedStorage:WaitForChild("Datas", 10):WaitForChild("Game", 10))
            if gd and gd.Game and gd.Game.AnimalGanerationModifier then
                gameMod = gd.Game.AnimalGanerationModifier
            end
        end)
        base = (info.Price or 0) * gameMod
    end
    local mult = 1
    local sleepy = false
    if mutation and mutation ~= "None" and _mutationsData then
        local md = _mutationsData[mutation]
        if md and md.Modifier then mult = mult + md.Modifier end
    end
    if type(traits) == "table" and _traitsData then
        for _, t in ipairs(traits) do
            if t == "Sleepy" then
                sleepy = true
            else
                local td = _traitsData[t]
                if td and td.MultiplierModifier then mult = mult + td.MultiplierModifier end
            end
        end
    end
    local v = math.round(base * mult)
    if sleepy then v = math.round(v * 0.5) end
    return v
end

function steal.genText(genValue)
    if _numberUtils and _numberUtils.ToString then
        local ok, s = pcall(function() return _numberUtils:ToString(genValue) end)
        if ok and type(s) == "string" then return "$" .. s .. "/s" end
    end
    if genValue >= 1e9 then return string.format("$%.2fB/s", genValue / 1e9) end
    if genValue >= 1e6 then return string.format("$%.2fM/s", genValue / 1e6) end
    if genValue >= 1e3 then return string.format("$%.2fK/s", genValue / 1e3) end
    return string.format("$%d/s", math.floor(genValue))
end

